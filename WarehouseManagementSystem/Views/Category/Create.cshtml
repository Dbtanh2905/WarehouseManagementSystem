@model WarehouseManagementSystem.Models.Category
@{
    ViewData["Title"] = "Thêm danh mục mới";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-1">Thêm danh mục linh kiện mới</h4>
                <p class="text-muted small mb-0">Tạo mới nhóm phân loại cho linh kiện điện tử</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
            </a>
        </div>

        <div class="wms-card">
            <div class="wms-card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                        <input asp-for="CategoryName" class="form-control" placeholder="VD: Vi điều khiển & Module nhúng" />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả tóm tắt đặc điểm các loại linh kiện thuộc danh mục..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Hủy bỏ</a>
                        <button type="submit" class="btn btn-wms-primary px-4">
                            <i class="bi bi-check2 me-1"></i>Lưu danh mục
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
