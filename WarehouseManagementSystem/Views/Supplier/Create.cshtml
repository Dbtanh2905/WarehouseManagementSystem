@model WarehouseManagementSystem.Models.Supplier
@{
    ViewData["Title"] = "Thêm nhà cung cấp mới";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-1">Thêm nhà cung cấp linh kiện</h4>
                <p class="text-muted small mb-0">Khai báo thông tin đối tác cung ứng vật tư bán dẫn</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
            </a>
        </div>

        <div class="wms-card">
            <div class="wms-card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="SupplierName" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                        <input asp-for="SupplierName" class="form-control" placeholder="VD: Foxconn Precision Components" />
                        <span asp-validation-for="SupplierName" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Phone" class="form-label fw-semibold small"></label>
                            <input asp-for="Phone" class="form-control" placeholder="024-xxxx-xxxx" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-semibold small"></label>
                            <input asp-for="Email" class="form-control" placeholder="supplier@domain.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Address" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Address" class="form-control" rows="2" placeholder="Địa chỉ nhà máy hoặc văn phòng đại diện..."></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Hủy bỏ</a>
                        <button type="submit" class="btn btn-wms-primary px-4">
                            <i class="bi bi-check2 me-1"></i>Lưu nhà cung cấp
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
