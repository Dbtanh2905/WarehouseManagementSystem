@model List<WarehouseManagementSystem.Models.StockTransaction>
@{
    ViewData["Title"] = "Lịch sử biến động tồn kho";
    int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    int totalPages = (int)(ViewData["TotalPages"] ?? 1);
    int totalItems = (int)(ViewData["TotalItems"] ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Sổ cái lịch sử biến động kho (Audit Trail)</h4>
        <p class="text-muted small mb-0">Theo dõi toàn bộ các lượt nhập, xuất vật tư linh kiện theo thời gian thực</p>
    </div>
    <a asp-controller="Report" asp-action="ExportTransactionsCsv" class="btn btn-outline-success btn-sm px-3 py-2">
        <i class="bi bi-file-earmark-spreadsheet me-1"></i>Xuất sổ cái CSV
    </a>
</div>

<!-- Bộ lọc -->
<div class="wms-card mb-4">
    <div class="wms-card-body p-3">
        <form method="get" class="row g-2">
            <div class="col-md-3">
                <input type="text" name="search" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="Mã chứng từ, mã linh kiện..." />
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<WarehouseManagementSystem.Models.TransactionType>()">
                    <option value="">-- Tất cả loại GD --</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="fromDate" value="@ViewData["CurrentFromDate"]" class="form-control" title="Từ ngày" />
            </div>
            <div class="col-md-2">
                <input type="date" name="toDate" value="@ViewData["CurrentToDate"]" class="form-control" title="Đến ngày" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1"><i class="bi bi-filter me-1"></i>Lọc</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="wms-card">
    <div class="wms-card-body p-0">
        <div class="table-responsive">
            <table class="table wms-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 150px;">Thời gian</th>
                        <th>Mã chứng từ</th>
                        <th>Loại giao dịch</th>
                        <th>Linh kiện</th>
                        <th>Vị trí kệ</th>
                        <th class="text-end">Biến động</th>
                        <th>Người thực hiện</th>
                        <th>Diễn giải</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-1"></i>Không có bản ghi giao dịch nào
                            </td>
                        </tr>
                    }
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="small text-muted font-monospace">@t.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>
                                <span class="fw-bold font-monospace @(t.TransactionType == WarehouseManagementSystem.Models.TransactionType.In ? "text-primary" : "text-danger")">
                                    @t.ReferenceCode
                                </span>
                            </td>
                            <td>
                                @if (t.TransactionType == WarehouseManagementSystem.Models.TransactionType.In)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                        <i class="bi bi-arrow-down-left me-1"></i>Nhập kho
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                        <i class="bi bi-arrow-up-right me-1"></i>Xuất kho
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@t.ProductId" class="fw-semibold text-dark text-decoration-none">
                                    @(t.Product?.ProductName)
                                </a>
                                <div class="small text-muted font-monospace">@(t.Product?.ProductCode)</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">
                                    @(t.Location?.LocationCode)
                                </span>
                            </td>
                            <td class="text-end">
                                <span class="fs-6 fw-bold @(t.TransactionType == WarehouseManagementSystem.Models.TransactionType.In ? "text-success" : "text-danger")">
                                    @(t.TransactionType == WarehouseManagementSystem.Models.TransactionType.In ? "+" : "-")@t.Quantity.ToString("N0")
                                </span>
                            </td>
                            <td class="small text-secondary">@(t.PerformedBy?.FullName ?? t.PerformedBy?.UserName ?? "—")</td>
                            <td class="small text-secondary">@(string.IsNullOrWhiteSpace(t.Note) ? "—" : t.Note)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted">Trang @currentPage / @totalPages (Tổng @totalItems giao dịch)</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewData["CurrentSearch"]" asp-route-type="@ViewData["CurrentType"]">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
