@model WarehouseManagementSystem.ViewModels.InventoryFilterViewModel
@{
    ViewData["Title"] = "Quản lý tồn kho linh kiện";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Theo dõi tồn kho linh kiện</h4>
        <p class="text-muted small mb-0">Quản lý tổng số lượng tồn thực tế và vị trí lưu trữ trên các ngăn kệ</p>
    </div>
    <a asp-controller="Report" asp-action="ExportInventoryCsv" asp-route-categoryId="@Model.CategoryId" class="btn btn-outline-success btn-sm px-3 py-2">
        <i class="bi bi-file-earmark-spreadsheet me-1"></i>Xuất Excel / CSV
    </a>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="wms-card mb-4">
    <div class="wms-card-body p-3">
        <form method="get" class="row g-2">
            <div class="col-md-4">
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Tìm theo mã hoặc tên linh kiện..." />
            </div>
            <div class="col-md-3">
                <select name="categoryId" asp-items="ViewBag.Categories" class="form-select">
                    <option value="">-- Tất cả danh mục --</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<WarehouseManagementSystem.Models.StockStatus>()">
                    <option value="">-- Tất cả trạng thái tồn --</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1"><i class="bi bi-filter me-1"></i>Lọc</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng tồn kho -->
<div class="wms-card">
    <div class="wms-card-body p-0">
        <div class="table-responsive">
            <table class="table wms-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 140px;">Mã linh kiện</th>
                        <th>Tên linh kiện</th>
                        <th>Danh mục</th>
                        <th>ĐVT</th>
                        <th>Vị trí kệ & Số lượng</th>
                        <th>Định mức tối thiểu</th>
                        <th>Tổng tồn kho</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 100px;">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-1"></i>Không có dữ liệu tồn kho phù hợp
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="font-monospace fw-bold text-decoration-none text-primary">
                                    @item.ProductCode
                                </a>
                            </td>
                            <td>
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="fw-semibold text-dark text-decoration-none">
                                    @item.ProductName
                                </a>
                            </td>
                            <td><span class="badge bg-light text-secondary border">@item.CategoryName</span></td>
                            <td>@item.Unit</td>
                            <td>
                                @if (!item.Locations.Any() || item.Locations.All(l => l.Quantity == 0))
                                {
                                    <span class="text-muted small">Chưa xếp vị trí</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var loc in item.Locations.Where(l => l.Quantity > 0))
                                        {
                                            <span class="badge bg-light text-dark border font-monospace py-1 px-2" title="@loc.LocationName">
                                                <i class="bi bi-geo-alt me-1 text-primary"></i>@loc.LocationCode: <strong>@loc.Quantity.ToString("N0")</strong>
                                            </span>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="text-muted">@item.MinimumStock.ToString("N0")</td>
                            <td>
                                <span class="fs-6 fw-bold @(item.Status == WarehouseManagementSystem.Models.StockStatus.OutOfStock ? "text-danger" : (item.Status == WarehouseManagementSystem.Models.StockStatus.LowStock ? "text-warning" : "text-success"))">
                                    @item.TotalQuantity.ToString("N0")
                                </span>
                            </td>
                            <td>
                                @if (item.Status == WarehouseManagementSystem.Models.StockStatus.OutOfStock)
                                {
                                    <span class="badge badge-status badge-status-outofstock">
                                        <i class="bi bi-exclamation-octagon-fill"></i>Hết hàng
                                    </span>
                                }
                                else if (item.Status == WarehouseManagementSystem.Models.StockStatus.LowStock)
                                {
                                    <span class="badge badge-status badge-status-lowstock">
                                        <i class="bi bi-exclamation-triangle-fill"></i>Sắp hết hàng
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-status badge-status-instock">
                                        <i class="bi bi-check-circle-fill"></i>Bình thường
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-info" title="Xem chi tiết và lịch sử giao dịch">
                                    <i class="bi bi-clock-history"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted">Trang @Model.PageNumber / @Model.TotalPages (Tổng @Model.TotalItems linh kiện)</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int idx = 1; idx <= Model.TotalPages; idx++)
                        {
                            <li class="page-item @(idx == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@idx" asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-status="@Model.Status">@idx</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
