@using Microsoft.AspNetCore.Identity
@using WarehouseManagementSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var currentRole = User.IsInRole("Admin") ? "Quản trị viên (Admin)" : "Nhân viên (Staff)";
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ Thống Quản Lý Kho WMS</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom Enterprise CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <div class="wms-wrapper">
            <!-- Sidebar Navigation -->
            <aside class="wms-sidebar">
                <a asp-controller="Dashboard" asp-action="Index" class="wms-sidebar-brand">
                    <i class="bi bi-cpu-fill"></i>
                    <span>WMS ELECTRONIC</span>
                </a>

                <ul class="wms-sidebar-menu">
                    <li class="wms-sidebar-heading">TỔNG QUAN</li>
                    <li class="wms-nav-item">
                        <a asp-controller="Dashboard" asp-action="Index" class="wms-nav-link @(currentController == "Dashboard" ? "active" : "")">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span>Bảng điều khiển</span>
                        </a>
                    </li>

                    <li class="wms-sidebar-heading">DANH MỤC VẬT TƯ</li>
                    <li class="wms-nav-item">
                        <a asp-controller="Product" asp-action="Index" class="wms-nav-link @(currentController == "Product" ? "active" : "")">
                            <i class="bi bi-memory"></i>
                            <span>Linh kiện điện tử</span>
                        </a>
                    </li>
                    <li class="wms-nav-item">
                        <a asp-controller="Category" asp-action="Index" class="wms-nav-link @(currentController == "Category" ? "active" : "")">
                            <i class="bi bi-tags-fill"></i>
                            <span>Danh mục linh kiện</span>
                        </a>
                    </li>
                    <li class="wms-nav-item">
                        <a asp-controller="Supplier" asp-action="Index" class="wms-nav-link @(currentController == "Supplier" ? "active" : "")">
                            <i class="bi bi-truck"></i>
                            <span>Nhà cung cấp</span>
                        </a>
                    </li>
                    <li class="wms-nav-item">
                        <a asp-controller="WarehouseLocation" asp-action="Index" class="wms-nav-link @(currentController == "WarehouseLocation" ? "active" : "")">
                            <i class="bi bi-geo-alt-fill"></i>
                            <span>Vị trí kệ kho</span>
                        </a>
                    </li>

                    <li class="wms-sidebar-heading">NGHIỆP VỤ KHO</li>
                    <li class="wms-nav-item">
                        <a asp-controller="StockReceipt" asp-action="Index" class="wms-nav-link @(currentController == "StockReceipt" ? "active" : "")">
                            <i class="bi bi-box-arrow-in-down"></i>
                            <span>Phiếu nhập kho</span>
                        </a>
                    </li>
                    <li class="wms-nav-item">
                        <a asp-controller="StockIssue" asp-action="Index" class="wms-nav-link @(currentController == "StockIssue" ? "active" : "")">
                            <i class="bi bi-box-arrow-up"></i>
                            <span>Phiếu xuất kho</span>
                        </a>
                    </li>
                    <li class="wms-nav-item">
                        <a asp-controller="Inventory" asp-action="Index" class="wms-nav-link @(currentController == "Inventory" ? "active" : "")">
                            <i class="bi bi-boxes"></i>
                            <span>Quản lý tồn kho</span>
                        </a>
                    </li>
                    <li class="wms-nav-item">
                        <a asp-controller="StockTransaction" asp-action="Index" class="wms-nav-link @(currentController == "StockTransaction" ? "active" : "")">
                            <i class="bi bi-clock-history"></i>
                            <span>Lịch sử biến động</span>
                        </a>
                    </li>

                    <li class="wms-sidebar-heading">BÁO CÁO & HỆ THỐNG</li>
                    <li class="wms-nav-item">
                        <a asp-controller="Report" asp-action="Index" class="wms-nav-link @(currentController == "Report" ? "active" : "")">
                            <i class="bi bi-bar-chart-line-fill"></i>
                            <span>Báo cáo thống kê</span>
                        </a>
                    </li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="wms-nav-item">
                            <a asp-controller="Account" asp-action="Users" class="wms-nav-link @(currentController == "Account" && currentAction == "Users" ? "active" : "")">
                                <i class="bi bi-people-fill"></i>
                                <span>Quản lý người dùng</span>
                            </a>
                        </li>
                    }
                </ul>
            </aside>

            <!-- Main Workspace -->
            <div class="wms-main-content">
                <!-- Topbar -->
                <header class="wms-topbar">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-semibold text-secondary">Hệ Thống Quản Lý Kho Linh Kiện Điện Tử</span>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <div class="text-end">
                            <div class="fw-bold small text-dark">@(currentUser?.FullName ?? User.Identity?.Name)</div>
                            <span class="badge @(User.IsInRole("Admin") ? "bg-primary" : "bg-secondary")" style="font-size: 0.7rem;">@currentRole</span>
                        </div>
                        
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle rounded-circle p-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 36px; height: 36px;">
                                <i class="bi bi-person-fill"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li>
                                    <div class="dropdown-header">
                                        <strong>@(currentUser?.FullName)</strong><br />
                                        <small class="text-muted">@(currentUser?.Email)</small>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Page Body -->
                <main class="wms-content-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main>
            @RenderBody()
        </main>
    }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
