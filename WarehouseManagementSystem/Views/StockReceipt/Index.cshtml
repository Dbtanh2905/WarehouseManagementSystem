@model WarehouseManagementSystem.ViewModels.StockReceiptListViewModel
@{
    ViewData["Title"] = "Quản lý phiếu nhập kho";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Phiếu nhập kho (Stock In)</h4>
        <p class="text-muted small mb-0">Quản lý nhập vật tư linh kiện từ nhà cung cấp vào các vị trí kệ</p>
    </div>
    <a asp-action="Create" class="btn btn-wms-primary btn-sm px-3 py-2">
        <i class="bi bi-plus-circle me-1"></i>Tạo phiếu nhập mới
    </a>
</div>

<!-- Bộ lọc -->
<div class="wms-card mb-4">
    <div class="wms-card-body p-3">
        <form method="get" class="row g-2">
            <div class="col-md-3">
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Mã phiếu, NCC, ghi chú..." />
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<WarehouseManagementSystem.Models.ReceiptStatus>()">
                    <option value="">-- Tất cả trạng thái --</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" title="Từ ngày" />
            </div>
            <div class="col-md-2">
                <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" title="Đến ngày" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1"><i class="bi bi-filter me-1"></i>Lọc</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<div class="wms-card">
    <div class="wms-card-body p-0">
        <div class="table-responsive">
            <table class="table wms-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 150px;">Mã phiếu nhập</th>
                        <th>Ngày nhập</th>
                        <th>Nhà cung cấp</th>
                        <th>Người lập</th>
                        <th>Số mặt hàng</th>
                        <th>Tổng số lượng</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Receipts.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-1"></i>Không tìm thấy phiếu nhập kho nào
                            </td>
                        </tr>
                    }
                    @foreach (var r in Model.Receipts)
                    {
                        int totalQty = r.ReceiptDetails.Sum(d => d.Quantity);
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@r.Id" class="fw-bold font-monospace text-decoration-none text-primary">
                                    @r.ReceiptCode
                                </a>
                            </td>
                            <td>@r.ReceiptDate.ToString("dd/MM/yyyy")</td>
                            <td>@(r.Supplier?.SupplierName ?? "—")</td>
                            <td class="small text-secondary">@(r.CreatedBy?.FullName ?? r.CreatedBy?.UserName ?? "—")</td>
                            <td><span class="badge bg-light text-dark border">@r.ReceiptDetails.Count dòng</span></td>
                            <td><strong class="text-dark">@totalQty.ToString("N0")</strong></td>
                            <td>
                                @if (r.Status == WarehouseManagementSystem.Models.ReceiptStatus.Confirmed)
                                {
                                    <span class="badge badge-status badge-status-confirmed">
                                        <i class="bi bi-check-circle-fill"></i>Đã nhập kho
                                    </span>
                                }
                                else if (r.Status == WarehouseManagementSystem.Models.ReceiptStatus.Draft)
                                {
                                    <span class="badge badge-status badge-status-draft">
                                        <i class="bi bi-pencil"></i>Bản nháp
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-status badge-status-cancelled">
                                        <i class="bi bi-x-circle"></i>Đã hủy
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-info me-1" title="Xem chi tiết phiếu">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (r.Status == WarehouseManagementSystem.Models.ReceiptStatus.Draft)
                                {
                                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary" title="Sửa bản nháp">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted">Trang @Model.PageNumber / @Model.TotalPages (Tổng @Model.TotalItems phiếu)</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.Status">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
