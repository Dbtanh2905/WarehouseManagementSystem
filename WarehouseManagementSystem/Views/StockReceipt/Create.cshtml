@model WarehouseManagementSystem.ViewModels.StockReceiptCreateViewModel
@{
    ViewData["Title"] = "Tạo phiếu nhập kho";
    var products = ViewBag.Products as List<WarehouseManagementSystem.Models.Product> ?? new();
    var locations = ViewBag.Locations as List<WarehouseManagementSystem.Models.WarehouseLocation> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-1">Tạo phiếu nhập kho (Stock In)</h4>
        <p class="text-muted small mb-0">Nhập linh kiện điện tử vào kho lưu trữ (Ban đầu lưu ở trạng thái Bản nháp)</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

<form asp-action="Create" method="post" id="receiptForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

    <div class="row">
        <!-- Thông tin chung phiếu nhập -->
        <div class="col-md-4 mb-3">
            <div class="wms-card">
                <div class="wms-card-header">
                    <span class="fw-bold"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Thông tin phiếu</span>
                </div>
                <div class="wms-card-body">
                    <div class="mb-3">
                        <label asp-for="ReceiptCode" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                        <input asp-for="ReceiptCode" class="form-control font-monospace text-uppercase fw-bold text-primary" />
                        <span asp-validation-for="ReceiptCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ReceiptDate" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                        <input asp-for="ReceiptDate" type="date" class="form-control" />
                        <span asp-validation-for="ReceiptDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SupplierId" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                        <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                            <option value="">-- Chọn nhà cung cấp --</option>
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Note" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Note" class="form-control" rows="3" placeholder="Ghi chú số hóa đơn, số lô hàng (Lot number), tình trạng đóng gói..."></textarea>
                    </div>

                    <div class="alert alert-info py-2 small mb-0">
                        <i class="bi bi-info-circle me-1"></i>Phiếu tạo mới sẽ ở trạng thái <strong>Bản nháp</strong>. Sau khi kiểm đếm thực tế, Quản trị viên (Admin) sẽ bấm duyệt để ghi tăng số lượng tồn kho.
                    </div>
                </div>
            </div>
        </div>

        <!-- Chi tiết các dòng linh kiện -->
        <div class="col-md-8 mb-3">
            <div class="wms-card">
                <div class="wms-card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-list-check me-2 text-primary"></i>Danh sách linh kiện nhập kho</span>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddRow">
                        <i class="bi bi-plus-circle me-1"></i>Thêm dòng
                    </button>
                </div>
                <div class="wms-card-body p-0">
                    <div class="table-responsive">
                        <table class="table wms-table align-middle" id="detailsTable">
                            <thead>
                                <tr>
                                    <th style="width: 45%;">Linh kiện <span class="text-danger">*</span></th>
                                    <th style="width: 35%;">Vị trí kệ nhập <span class="text-danger">*</span></th>
                                    <th style="width: 15%;">Số lượng <span class="text-danger">*</span></th>
                                    <th style="width: 5%;"></th>
                                </tr>
                            </thead>
                            <tbody id="detailsBody">
                                @for (int i = 0; i < Model.Details.Count; i++)
                                {
                                    <tr class="detail-row">
                                        <td>
                                            <select name="Details[@i].ProductId" class="form-select form-select-sm product-select" required>
                                                <option value="">-- Chọn linh kiện --</option>
                                                @foreach (var p in products)
                                                {
                                                    <option value="@p.Id" selected="@(Model.Details[i].ProductId == p.Id)">
                                                        @p.ProductCode - @p.ProductName (@p.Unit)
                                                    </option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <select name="Details[@i].LocationId" class="form-select form-select-sm" required>
                                                <option value="">-- Chọn vị trí kệ --</option>
                                                @foreach (var l in locations)
                                                {
                                                    <option value="@l.Id" selected="@(Model.Details[i].LocationId == l.Id)">
                                                        @l.LocationCode - @l.LocationName
                                                    </option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" name="Details[@i].Quantity" value="@Model.Details[i].Quantity" min="1" class="form-control form-control-sm text-end" required />
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-link text-danger p-0 btn-remove-row" title="Xóa dòng">
                                                <i class="bi bi-trash fs-5"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="wms-card-body border-top d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light">Hủy bỏ</a>
                    <button type="submit" class="btn btn-wms-primary px-4">
                        <i class="bi bi-check2 me-1"></i>Lưu phiếu nhập
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tbody = document.getElementById('detailsBody');
            const btnAdd = document.getElementById('btnAddRow');

            function updateRowIndices() {
                const rows = tbody.querySelectorAll('.detail-row');
                rows.forEach((row, index) => {
                    row.querySelectorAll('select, input').forEach(input => {
                        const name = input.getAttribute('name');
                        if (name) {
                            input.setAttribute('name', name.replace(/Details\[\d+\]/, `Details[${index}]`));
                        }
                    });
                });
            }

            btnAdd.addEventListener('click', function () {
                const firstRow = tbody.querySelector('.detail-row');
                if (!firstRow) return;

                const newRow = firstRow.cloneNode(true);
                newRow.querySelectorAll('select').forEach(s => s.selectedIndex = 0);
                newRow.querySelector('input[type="number"]').value = 1;
                tbody.appendChild(newRow);
                updateRowIndices();
            });

            tbody.addEventListener('click', function (e) {
                if (e.target.closest('.btn-remove-row')) {
                    const rows = tbody.querySelectorAll('.detail-row');
                    if (rows.length > 1) {
                        e.target.closest('.detail-row').remove();
                        updateRowIndices();
                    } else {
                        alert('Phiếu nhập phải có ít nhất 1 dòng linh kiện.');
                    }
                }
            });
        });
    </script>
}
