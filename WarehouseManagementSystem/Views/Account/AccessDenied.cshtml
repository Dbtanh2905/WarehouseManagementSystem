@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="display-1 text-danger mb-3">
            <i class="bi bi-shield-x"></i>
        </div>
        <h2 class="fw-bold mb-2">Không có quyền truy cập</h2>
        <p class="text-muted mb-4">
            Tài khoản của bạn không có đủ thẩm quyền để truy cập vào tài nguyên hoặc thực hiện hành động này.
            Một số chức năng (như duyệt phiếu, quản lý người dùng, chỉnh sửa danh mục) chỉ dành riêng cho Quản trị viên (Admin).
        </p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-wms-primary px-4 py-2">
            <i class="bi bi-arrow-left me-2"></i>Quay lại Trang chủ
        </a>
    </div>
</div>
