@model List<WarehouseManagementSystem.ViewModels.UserViewModel>
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Quản lý tài khoản người dùng</h4>
        <p class="text-muted small mb-0">Danh sách nhân sự được phân quyền trong hệ thống WMS</p>
    </div>
    <button type="button" class="btn btn-wms-primary btn-sm px-3 py-2" data-bs-toggle="modal" data-bs-target="#createUserModal">
        <i class="bi bi-person-plus-fill me-1"></i>Thêm tài khoản mới
    </button>
</div>

<div class="wms-card">
    <div class="wms-card-body p-0">
        <div class="table-responsive">
            <table class="table wms-table align-middle">
                <thead>
                    <tr>
                        <th>Họ và tên</th>
                        <th>Email đăng nhập</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@user.FullName</div>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge @(user.Role == "Admin" ? "bg-primary" : "bg-secondary")">
                                    @user.Role
                                </span>
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                        <i class="bi bi-check-circle me-1"></i>Đang hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                        <i class="bi bi-lock me-1"></i>Đã khóa
                                    </span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        <i class="bi @(user.IsActive ? "bi-lock" : "bi-unlock") me-1"></i>
                                        @(user.IsActive ? "Khóa" : "Kích hoạt")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm Người Dùng -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateUser" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createUserModalLabel">Thêm tài khoản nhân viên mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" class="form-control" placeholder="Nguyễn Văn A" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Email đăng nhập <span class="text-danger">*</span></label>
                        <input type="email" name="Email" class="form-control" placeholder="user@wms.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Vai trò <span class="text-danger">*</span></label>
                        <select name="Role" class="form-select" required>
                            <option value="Staff">Nhân viên kho (Staff)</option>
                            <option value="Admin">Quản trị viên (Admin)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Mật khẩu ban đầu <span class="text-danger">*</span></label>
                        <input type="password" name="Password" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-wms-primary">Tạo tài khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>
