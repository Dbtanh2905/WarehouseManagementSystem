@model WarehouseManagementSystem.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển tổng quan";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Bảng điều khiển quản lý kho (WMS Dashboard)</h4>
        <p class="text-muted small mb-0">Tổng quan tình hình luân chuyển vật tư và an toàn tồn kho linh kiện điện tử</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="StockReceipt" asp-action="Create" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-box-arrow-in-down me-1"></i>Nhập kho mới
        </a>
        <a asp-controller="StockIssue" asp-action="Create" class="btn btn-outline-danger btn-sm">
            <i class="bi bi-box-arrow-up me-1"></i>Xuất kho mới
        </a>
    </div>
</div>

<!-- 5 KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-2-4 col-sm-6" style="flex: 0 0 auto; width: 20%;">
        <div class="wms-stat-card">
            <div>
                <div class="wms-stat-label">LOẠI LINH KIỆN</div>
                <div class="wms-stat-value text-primary">@Model.TotalProductTypes.ToString("N0")</div>
            </div>
            <div class="wms-stat-icon bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-cpu"></i>
            </div>
        </div>
    </div>
    <div class="col-md-2-4 col-sm-6" style="flex: 0 0 auto; width: 20%;">
        <div class="wms-stat-card">
            <div>
                <div class="wms-stat-label">TỔNG TỒN THỰC TẾ</div>
                <div class="wms-stat-value text-success">@Model.TotalInventoryQuantity.ToString("N0")</div>
            </div>
            <div class="wms-stat-icon bg-success bg-opacity-10 text-success">
                <i class="bi bi-boxes"></i>
            </div>
        </div>
    </div>
    <div class="col-md-2-4 col-sm-6" style="flex: 0 0 auto; width: 20%;">
        <div class="wms-stat-card">
            <div>
                <div class="wms-stat-label">PHIẾU NHẬP THÁNG</div>
                <div class="wms-stat-value text-info">@Model.StockReceiptsThisMonth.ToString("N0")</div>
            </div>
            <div class="wms-stat-icon bg-info bg-opacity-10 text-info">
                <i class="bi bi-box-arrow-in-down"></i>
            </div>
        </div>
    </div>
    <div class="col-md-2-4 col-sm-6" style="flex: 0 0 auto; width: 20%;">
        <div class="wms-stat-card">
            <div>
                <div class="wms-stat-label">PHIẾU XUẤT THÁNG</div>
                <div class="wms-stat-value text-danger">@Model.StockIssuesThisMonth.ToString("N0")</div>
            </div>
            <div class="wms-stat-icon bg-danger bg-opacity-10 text-danger">
                <i class="bi bi-box-arrow-up"></i>
            </div>
        </div>
    </div>
    <div class="col-md-2-4 col-sm-6" style="flex: 0 0 auto; width: 20%;">
        <div class="wms-stat-card">
            <div>
                <div class="wms-stat-label">DƯỚI TỒN TỐI THIỂU</div>
                <div class="wms-stat-value text-warning">@Model.LowStockProductCount.ToString("N0")</div>
            </div>
            <div class="wms-stat-icon bg-warning bg-opacity-10 text-warning">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
        </div>
    </div>
</div>

<!-- Biểu đồ Nhập/Xuất 6 tháng & Danh sách Cảnh báo dưới định mức -->
<div class="row mb-4">
    <div class="col-lg-8 mb-3">
        <div class="wms-card h-100">
            <div class="wms-card-header">
                <span class="fw-bold"><i class="bi bi-bar-chart-fill me-2 text-primary"></i>Biến động sản lượng Nhập / Xuất (6 tháng gần nhất)</span>
            </div>
            <div class="wms-card-body">
                <canvas id="monthlyStockChart" height="130"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-3">
        <div class="wms-card h-100">
            <div class="wms-card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="bi bi-bell-fill me-2 text-warning"></i>Cảnh báo định mức tồn</span>
                <a asp-controller="Inventory" asp-action="Index" asp-route-status="1" class="small text-decoration-none">Xem tất cả</a>
            </div>
            <div class="wms-card-body p-0">
                @if (!Model.LowStockItems.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-shield-check fs-2 text-success d-block mb-1"></i>Tất cả linh kiện đều trên mức tồn tối thiểu
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.LowStockItems)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-semibold text-dark">@item.ProductName</div>
                                    <small class="text-muted font-monospace">@item.ProductCode &bullet; Min: @item.MinimumStock @item.Unit</small>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold @(item.TotalQuantity == 0 ? "text-danger" : "text-warning")">
                                        @item.TotalQuantity @item.Unit
                                    </div>
                                    <span class="badge @(item.TotalQuantity == 0 ? "badge-status-outofstock" : "badge-status-lowstock")" style="font-size: 0.65rem;">
                                        @(item.TotalQuantity == 0 ? "Hết hàng" : "Sắp hết")
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Bảng Giao dịch gần đây (Audit Trail) -->
<div class="wms-card">
    <div class="wms-card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Giao dịch kho vừa phát sinh gần đây</span>
        <a asp-controller="StockTransaction" asp-action="Index" class="small text-decoration-none">Xem toàn bộ sổ cái</a>
    </div>
    <div class="wms-card-body p-0">
        <div class="table-responsive">
            <table class="table wms-table align-middle">
                <thead>
                    <tr>
                        <th>Thời gian</th>
                        <th>Chứng từ</th>
                        <th>Loại GD</th>
                        <th>Linh kiện</th>
                        <th>Vị trí</th>
                        <th class="text-end">Số lượng</th>
                        <th>Người thực hiện</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentTransactions.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-3 text-muted">Chưa có giao dịch phát sinh</td>
                        </tr>
                    }
                    @foreach (var tx in Model.RecentTransactions)
                    {
                        <tr>
                            <td class="small text-muted font-monospace">@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="font-monospace fw-semibold">@tx.ReferenceCode</td>
                            <td>
                                @if (tx.TransactionType == WarehouseManagementSystem.Models.TransactionType.In)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Nhập kho</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">Xuất kho</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@(tx.Product?.ProductName)</div>
                                <small class="text-muted font-monospace">@(tx.Product?.ProductCode)</small>
                            </td>
                            <td><span class="badge bg-light text-dark border font-monospace">@(tx.Location?.LocationCode)</span></td>
                            <td class="text-end">
                                <span class="fw-bold @(tx.TransactionType == WarehouseManagementSystem.Models.TransactionType.In ? "text-success" : "text-danger")">
                                    @(tx.TransactionType == WarehouseManagementSystem.Models.TransactionType.In ? "+" : "-")@tx.Quantity.ToString("N0")
                                </span>
                            </td>
                            <td class="small text-secondary">@(tx.PerformedBy?.FullName ?? tx.PerformedBy?.UserName ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ctx = document.getElementById('monthlyStockChart').getContext('2d');
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels));
            const inData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyStockInQuantities));
            const outData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyStockOutQuantities));

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Số lượng nhập kho',
                            data: inData,
                            backgroundColor: 'rgba(16, 185, 129, 0.75)',
                            borderColor: '#10B981',
                            borderWidth: 1,
                            borderRadius: 4
                        },
                        {
                            label: 'Số lượng xuất kho',
                            data: outData,
                            backgroundColor: 'rgba(239, 68, 68, 0.75)',
                            borderColor: '#EF4444',
                            borderWidth: 1,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                font: {
                                    family: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto'
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0
                            }
                        }
                    }
                }
            });
        });
    </script>
}
