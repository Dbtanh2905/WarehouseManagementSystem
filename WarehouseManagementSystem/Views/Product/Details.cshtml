@model WarehouseManagementSystem.Models.Product
@{
    ViewData["Title"] = $"Chi tiết linh kiện - {Model.ProductCode}";
    var invDetail = ViewBag.InventoryDetail as WarehouseManagementSystem.ViewModels.InventoryItemViewModel;
    var transactions = ViewBag.Transactions as List<WarehouseManagementSystem.Models.StockTransaction> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold mb-0">@Model.ProductName</h4>
            <span class="badge bg-primary font-monospace fs-6">@Model.ProductCode</span>
            @if (Model.IsActive)
            {
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Đang hoạt động</span>
            }
            else
            {
                <span class="badge bg-secondary">Ngừng sử dụng</span>
            }
        </div>
        <p class="text-muted small mb-0 mt-1">Danh mục: <strong>@(Model.Category?.CategoryName)</strong> &bullet; Nhà cung cấp: <strong>@(Model.Supplier?.SupplierName)</strong></p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-wms-primary btn-sm">
                <i class="bi bi-pencil me-1"></i>Sửa thông tin
            </a>
        }
    </div>
</div>

<div class="row">
    <!-- Card Thông tin tồn kho & Định mức -->
    <div class="col-md-4">
        <div class="wms-card mb-4">
            <div class="wms-card-header">
                <span class="fw-bold"><i class="bi bi-boxes me-2 text-primary"></i>Tình trạng tồn kho</span>
            </div>
            <div class="wms-card-body">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                    <span class="text-muted">Tổng tồn kho thực tế:</span>
                    <span class="fs-4 fw-bold text-dark">@(invDetail?.TotalQuantity.ToString("N0") ?? "0") @Model.Unit</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                    <span class="text-muted">Định mức tồn tối thiểu:</span>
                    <span class="fw-bold text-secondary">@Model.MinimumStock.ToString("N0") @Model.Unit</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted">Đánh giá trạng thái:</span>
                    @if (invDetail?.Status == WarehouseManagementSystem.Models.StockStatus.OutOfStock)
                    {
                        <span class="badge badge-status badge-status-outofstock">Hết hàng</span>
                    }
                    else if (invDetail?.Status == WarehouseManagementSystem.Models.StockStatus.LowStock)
                    {
                        <span class="badge badge-status badge-status-lowstock">Sắp hết hàng (Dưới định mức)</span>
                    }
                    else
                    {
                        <span class="badge badge-status badge-status-instock">Đảm bảo sản xuất</span>
                    }
                </div>
            </div>
        </div>

        <div class="wms-card">
            <div class="wms-card-header">
                <span class="fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>Thông số & Ghi chú</span>
            </div>
            <div class="wms-card-body">
                <p class="small text-secondary mb-0">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả kỹ thuật." : Model.Description)
                </p>
            </div>
        </div>
    </div>

    <!-- Tồn kho theo từng vị trí & Lịch sử giao dịch -->
    <div class="col-md-8">
        <!-- Vị trí lưu kho -->
        <div class="wms-card mb-4">
            <div class="wms-card-header">
                <span class="fw-bold"><i class="bi bi-geo-alt-fill me-2 text-primary"></i>Phân bổ số lượng tại các vị trí kệ</span>
            </div>
            <div class="wms-card-body p-0">
                <div class="table-responsive">
                    <table class="table wms-table align-middle">
                        <thead>
                            <tr>
                                <th>Mã vị trí</th>
                                <th>Tên kệ lưu trữ</th>
                                <th>Số lượng tồn</th>
                                <th>Cập nhật gần nhất</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (invDetail?.Locations == null || !invDetail.Locations.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-3 text-muted">Chưa có bản ghi tồn kho nào tại các vị trí kệ</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var loc in invDetail.Locations)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-light text-primary border border-primary border-opacity-25 font-monospace">
                                                @loc.LocationCode
                                            </span>
                                        </td>
                                        <td class="fw-semibold">@loc.LocationName</td>
                                        <td>
                                            <span class="fw-bold @(loc.Quantity > 0 ? "text-success" : "text-danger")">
                                                @loc.Quantity.ToString("N0") @Model.Unit
                                            </span>
                                        </td>
                                        <td class="small text-muted">@loc.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Lịch sử giao dịch biến động -->
        <div class="wms-card">
            <div class="wms-card-header">
                <span class="fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Lịch sử biến động nhập / xuất của linh kiện</span>
            </div>
            <div class="wms-card-body p-0">
                <div class="table-responsive">
                    <table class="table wms-table align-middle">
                        <thead>
                            <tr>
                                <th>Thời gian</th>
                                <th>Mã chứng từ</th>
                                <th>Loại GD</th>
                                <th>Vị trí kệ</th>
                                <th>Số lượng</th>
                                <th>Người thực hiện</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!transactions.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-3 text-muted">Chưa phát sinh giao dịch nhập/xuất nào cho linh kiện này</td>
                                </tr>
                            }
                            @foreach (var tx in transactions)
                            {
                                <tr>
                                    <td class="small text-muted">@tx.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="fw-semibold font-monospace">@tx.ReferenceCode</span>
                                    </td>
                                    <td>
                                        @if (tx.TransactionType == WarehouseManagementSystem.Models.TransactionType.In)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                                <i class="bi bi-arrow-down-left me-1"></i>Nhập kho
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                                <i class="bi bi-arrow-up-right me-1"></i>Xuất kho
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace">@(tx.Location?.LocationCode)</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold @(tx.TransactionType == WarehouseManagementSystem.Models.TransactionType.In ? "text-success" : "text-danger")">
                                            @(tx.TransactionType == WarehouseManagementSystem.Models.TransactionType.In ? "+" : "-")@tx.Quantity.ToString("N0")
                                        </span>
                                    </td>
                                    <td class="small text-secondary">@(tx.PerformedBy?.FullName ?? tx.PerformedBy?.UserName)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
