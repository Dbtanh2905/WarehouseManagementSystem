@model WarehouseManagementSystem.Models.Product
@{
    ViewData["Title"] = "Thêm linh kiện mới";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold mb-1">Thêm linh kiện điện tử mới</h4>
                <p class="text-muted small mb-0">Khai báo mã định danh, nhà cung ứng và định mức tồn an toàn</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
            </a>
        </div>

        <div class="wms-card">
            <div class="wms-card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="row">
                        <div class="col-md-5 mb-3">
                            <label asp-for="ProductCode" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                            <input asp-for="ProductCode" class="form-control font-monospace text-uppercase" placeholder="VD: CPU-I9-14900K" />
                            <span asp-validation-for="ProductCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-7 mb-3">
                            <label asp-for="ProductName" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                            <input asp-for="ProductName" class="form-control" placeholder="VD: Intel Core i9-14900K 24-Core 32-Thread" />
                            <span asp-validation-for="ProductName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SupplierId" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                            <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                                <option value="">-- Chọn nhà cung cấp --</option>
                            </select>
                            <span asp-validation-for="SupplierId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Unit" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                            <input asp-for="Unit" class="form-control" placeholder="Cái, Chiếc, Cuộn, Con, Vỉ..." />
                            <span asp-validation-for="Unit" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MinimumStock" class="form-label fw-semibold small"></label> <span class="text-danger">*</span>
                            <input asp-for="MinimumStock" type="number" class="form-control" min="0" />
                            <span class="text-muted small">Cảnh báo khi tổng tồn kho dưới hoặc bằng số này</span>
                            <span asp-validation-for="MinimumStock" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Thông số kỹ thuật, footprint linh kiện, dải nhiệt độ hoạt động..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="IsActive" class="form-check-input" checked />
                        <label asp-for="IsActive" class="form-check-label small fw-semibold text-secondary"></label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light">Hủy bỏ</a>
                        <button type="submit" class="btn btn-wms-primary px-4">
                            <i class="bi bi-check2 me-1"></i>Lưu linh kiện
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
