@model List<WarehouseManagementSystem.Models.Product>
@{
    ViewData["Title"] = "Quản lý linh kiện điện tử";
    int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
    int totalPages = (int)(ViewData["TotalPages"] ?? 1);
    int totalItems = (int)(ViewData["TotalItems"] ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Danh mục linh kiện điện tử</h4>
        <p class="text-muted small mb-0">Quản lý mã định danh, thông số kỹ thuật, nhà cung cấp và tồn tối thiểu</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-wms-primary btn-sm px-3 py-2">
            <i class="bi bi-plus-circle me-1"></i>Thêm linh kiện mới
        </a>
    }
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="wms-card mb-4">
    <div class="wms-card-body p-3">
        <form method="get" class="row g-2">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="Tìm theo mã linh kiện, tên sản phẩm..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="categoryId" asp-items="ViewBag.Categories" class="form-select">
                    <option value="">-- Tất cả danh mục --</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1"><i class="bi bi-filter me-1"></i>Lọc dữ liệu</button>
                @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"] as string) || ViewData["CurrentCategory"] != null)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Danh sách linh kiện -->
<div class="wms-card">
    <div class="wms-card-body p-0">
        <div class="table-responsive">
            <table class="table wms-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 140px;">Mã linh kiện</th>
                        <th>Tên linh kiện</th>
                        <th>Danh mục</th>
                        <th>Nhà cung cấp</th>
                        <th>ĐVT</th>
                        <th>Tồn tối thiểu</th>
                        <th>Tổng tồn</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-1"></i>Không tìm thấy linh kiện nào
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        int currentStock = item.Inventories.Sum(i => i.Quantity);
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-decoration-none font-monospace text-primary">
                                    @item.ProductCode
                                </a>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-dark fw-semibold text-decoration-none">
                                    @item.ProductName
                                </a>
                            </td>
                            <td><span class="badge bg-light text-secondary border">@(item.Category?.CategoryName ?? "—")</span></td>
                            <td class="small text-secondary">@(item.Supplier?.SupplierName ?? "—")</td>
                            <td>@item.Unit</td>
                            <td class="text-muted">@item.MinimumStock.ToString("N0")</td>
                            <td>
                                @if (currentStock == 0)
                                {
                                    <span class="badge badge-status badge-status-outofstock">0</span>
                                }
                                else if (currentStock <= item.MinimumStock)
                                {
                                    <span class="badge badge-status badge-status-lowstock">@currentStock.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="badge badge-status badge-status-instock">@currentStock.ToString("N0")</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25">Ngưng</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1" title="Xem chi tiết tồn và lịch sử">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1" title="Sửa thông tin">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline" title="@(item.IsActive ? "Ngừng sử dụng" : "Kích hoạt lại")">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success") me-1">
                                            <i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa linh kiện này? Nếu đã phát sinh giao dịch hệ thống sẽ từ chối xóa.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        @if (totalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted">Hiển thị trang @currentPage / @totalPages (Tổng @totalItems linh kiện)</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@ViewData["CurrentSearch"]" asp-route-categoryId="@ViewData["CurrentCategory"]">&laquo;</a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewData["CurrentSearch"]" asp-route-categoryId="@ViewData["CurrentCategory"]">@i</a>
                            </li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@ViewData["CurrentSearch"]" asp-route-categoryId="@ViewData["CurrentCategory"]">&raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
